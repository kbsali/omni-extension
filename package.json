{
  "name": "omni-extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check": "oxlint && bun fmt --check && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "git config core.hooksPath .githooks",
    "fix": "oxlint --fix && bun fmt"
  },
  "dependencies": {
    "emojibase-data": "^17.0.0",
    "tldts": "^7.5.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^20.14.6",
    "oxlint": "1.94.0",
    "sinon-chrome": "^3.0.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
